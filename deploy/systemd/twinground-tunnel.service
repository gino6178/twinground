[Unit]
Description=Cloudflare quick tunnel for TwinGround (port 8766)
After=twinground-web.service
Wants=twinground-web.service
[Service]
Type=simple
ExecStart=/home/gino/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8766
Restart=on-failure
RestartSec=5
[Install]
WantedBy=default.target
