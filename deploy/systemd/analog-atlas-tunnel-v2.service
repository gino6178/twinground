[Unit]
Description=Cloudflare quick tunnel for the rebuilt Analog Atlas (port 8766)
After=analog-atlas-web-v2.service
Wants=analog-atlas-web-v2.service
[Service]
Type=simple
ExecStart=/home/gino/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8766
Restart=on-failure
RestartSec=5
[Install]
WantedBy=default.target
